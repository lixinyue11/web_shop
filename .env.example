# ============================================================
# SheShop 环境变量配置模板
# 使用方法：复制本文件为 .env，按实际环境修改
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
# 注意：.env 文件包含敏感信息，已加入 .gitignore，不会上传到 Git
# ============================================================

# ------------------ 基础配置 ------------------

# 密钥：生产环境必须修改为随机字符串
# 生成方法：python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=django-insecure-dev-key-change-me-in-production

# 调试模式：本地开发 True，生产服务器必须改为 False
DEBUG=True

# 允许访问的域名/IP，多个用英文逗号分隔
# 本地开发：127.0.0.1,localhost
# 生产环境：shop.example.com,www.shop.example.com
ALLOWED_HOSTS=127.0.0.1,localhost

# HTTPS 部署时填写完整地址，多个用逗号分隔（http 部署可留空）
CSRF_TRUSTED_ORIGINS=


# ------------------ 数据库配置 ------------------

# 数据库类型：postgresql 或 sqlite
# 本地快速调试可用 sqlite，正式环境用 postgresql
DB_ENGINE=postgresql

# PostgreSQL 连接参数
# 本地 Docker：DB_HOST=localhost
# docker-compose 内部：DB_HOST=db
# 远程/云数据库：填写服务商提供的地址，如 xxx.rds.aliyuncs.com
DB_NAME=she_shop
DB_USER=sheshop
DB_PASSWORD=change-this-password
DB_HOST=localhost
DB_PORT=5432

# SSL 模式：disable / allow / prefer / require / verify-ca / verify-full
# 本地用 prefer，云数据库通常需要 require
DB_SSLMODE=prefer

# 连接复用时间（秒），远程数据库建议 60 以上以减少连接开销
DB_CONN_MAX_AGE=60

# 连接超时（秒）
DB_CONNECT_TIMEOUT=10

# 使用 sqlite 时的数据库文件名（DB_ENGINE=sqlite 时生效）
SQLITE_NAME=db.sqlite3


# ------------------ 站点配置 ------------------

SITE_NAME=SheShop
SITE_SLOGAN=专为女性打造的精品购物平台
SITE_FOOTER_TEXT=让每一位女性都能找到属于自己的美丽

# 前端资源加载方式：cdn（需联网）/ local（离线，需先下载静态文件到 static 目录）
FRONTEND_ASSETS=cdn


# ------------------ 文件上传 ------------------

# 媒体文件存储路径，留空则用项目下的 media 目录
# 服务器上建议挂载独立磁盘，如 /data/sheshop/media
MEDIA_ROOT=

# DEBUG=False 时是否由 Django 提供媒体文件访问
# 已配置 Nginx 或对象存储时保持 False；没配 Nginx 又发现图片打不开时改为 True
SERVE_MEDIA=False

MEDIA_URL=/media/
STATIC_URL=/static/
STATIC_ROOT=staticfiles

# 单文件最大上传大小（字节），默认 10MB
MAX_UPLOAD_SIZE=10485760

# 单次最多上传图片张数
MAX_UPLOAD_IMAGES=9


# ------------------ 商品规格 ------------------

# 单个商品最多生成的规格组合数
# 组合数 = 各维度取值数相乘，例如 颜色3种 × 尺码5种 = 15 个组合
MAX_SKU_COMBINATIONS=200

# 单个商品最多可定义几个规格维度（颜色、尺码、型号、材质...）
MAX_SPEC_DIMENSIONS=5


# ------------------ 安全配置（生产环境）------------------
# 以下仅在 DEBUG=False 时生效

# 强制跳转 HTTPS（确认已配置证书后再开启）
SECURE_SSL_REDIRECT=False

# Cookie 仅通过 HTTPS 传输
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# 使用 Nginx 等反向代理且代理层处理 HTTPS 时设为 True
USE_X_FORWARDED_PROTO=False

# 会话有效期（秒），默认 14 天
SESSION_COOKIE_AGE=1209600

# 是否启用密码强度校验
ENABLE_PASSWORD_VALIDATION=False
PASSWORD_MIN_LENGTH=6


# ------------------ 日志配置 ------------------

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 是否写入文件日志（生产环境建议 True）
LOG_TO_FILE=False
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5


# ------------------ 国际化 ------------------

LANGUAGE_CODE=zh-hans
TIME_ZONE=Asia/Shanghai


# ------------------ Docker Compose 专用 ------------------
# 仅在使用 docker-compose 启动内置 PostgreSQL 时生效

POSTGRES_DB=she_shop
POSTGRES_USER=sheshop
POSTGRES_PASSWORD=change-this-password

# 宿主机映射端口，若 5432 被占用可改为 15432
# 注意：该端口只绑定 127.0.0.1，不会暴露到公网
POSTGRES_HOST_PORT=5432

# Web 服务对外端口
WEB_HOST_PORT=8000

# Gunicorn 运行参数
# 工作进程数建议设为 CPU 核数 × 2 + 1
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
